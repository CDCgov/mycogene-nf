profiles {
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        process {
            withName: DOWNLOAD_SRA {
                container = 'staphb/sratoolkit:latest'
            }
            withName: FASTP {
                container = 'staphb/fastp:latest'
            }
            withName: FASTPLONG {
                container = 'staphb/fastplong:latest'
            }
            withName: ASSEMBLY_ILLUMINA {
                container = 'staphb/spades:latest'
            }
            withName: ASSEMBLY_ONT {
                container = 'staphb/flye:latest'
            }
            withName: blast_run {
                container = 'staphb/blast:latest'
            }
            withName: combine_and_align {
                container = 'staphb/clustalo:latest'
            }
            withName: visualize_snps {
                container = 'raphsoft/mview:1.67'
            }
            withName: extract_best_hit {
                container = 'staphb/blast:latest'
            }
            withName: extract_cyp51_coding_noncoding_sequence {
                container = 'staphb/samtools:latest'
            }
            withName: identify_distance_TR {
                container = 'staphb/blast:latest'
            }
            withName: align_cyp51 {
                container = 'staphb/clustalo:latest'
            }
            withName: plot_TR {
                container = 'raphsoft/mview:1.67'
            }
            withName: gene_coverage {
                container = 'quay.io/biocontainers/python:3.8.3'
            }
            withName: SAMPLE_QC {
                container = 'quay.io/biocontainers/python:3.8.3'
            }
            withName: MERGE_QC {
                container = 'quay.io/biocontainers/python:3.8.3'
            }
            withName: parse_mutations {
                container = 'quay.io/biocontainers/python:3.8.3'
            }
        }
    }
}
manifest {
    name            = 'CDCgov/mycogene-nf'
    author          = 'CDC'
    homePage        = 'https://github.com/CDCgov/mycogene-nf'
    description     = 'mycogene-nf is a Nextflow pipeline for comparing gene sequences from sequencing reads and identifying amino acid variants associated with genetic markers such as antimicrobial resistance.'
    mainScript      = 'main.nf'
    version         = '1.3.2'
}

// Execution reports, matching the convention already used in mycosnp-nf.
// params.outdir defaults inside main.nf rather than here, and nextflow.config
// is evaluated before main.nf runs, so `?: 'results'` guards against
// params.outdir not being resolved yet if --outdir isn't passed on the CLI.
def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
def tracedir = "${params.outdir ?: 'results'}/pipeline_info"

timeline {
    enabled = true
    file    = "${tracedir}/execution_timeline_${trace_timestamp}.html"
}
report {
    enabled = true
    file    = "${tracedir}/execution_report_${trace_timestamp}.html"
}
trace {
    enabled = true
    file    = "${tracedir}/execution_trace_${trace_timestamp}.txt"
}
dag {
    enabled = true
    file    = "${tracedir}/pipeline_dag_${trace_timestamp}.svg"
}